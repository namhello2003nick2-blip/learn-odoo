<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="group_my_crm_user" model="res.groups">
        <field name="name">My CRM User</field>
    </record>

    <record id="group_my_crm_manager" model="res.groups">
        <field name="name">My CRM Manager</field>
    </record>

    <record id="rule_customer_user" model="ir.rule">
        <field name="name">Customer: Own Records</field>
        <field name="model_id" ref="model_my_crm_customer"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('my_crm.group_my_crm_user'))]"/>
    </record>

    <record id="rule_customer_manager" model="ir.rule">
        <field name="name">Customer: Manager All Records</field>
        <field name="model_id" ref="model_my_crm_customer"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('my_crm.group_my_crm_manager'))]"/>
    </record>
</odoo>