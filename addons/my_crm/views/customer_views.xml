<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Customer List View -->
    <record id="view_customer_list" model="ir.ui.view">
        <field name="name">my.crm.customer.list</field>
        <field name="model">my.crm.customer</field>

        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>


    <!-- Customer Form View -->
    <record id="view_customer_form" model="ir.ui.view">
        <field name="name">my.crm.customer.form</field>
        <field name="model">my.crm.customer</field>

        <field name="arch" type="xml">
            <form>

                <!-- Buttons -->
                <header>
                    <button
                        name="action_create_test_opportunity"
                        type="object"
                        string="Create Test Opportunity"
                        class="btn-primary"
                    />
                </header>

                <sheet>

                    <notebook>

                        <!-- General -->
                        <page string="General">
                            <group>
                                <field name="name"/>
                                <field name="email"/>
                                <field name="phone"/>
                            </group>
                        </page>


                        <!-- Opportunities -->
                        <page string="Opportunities">

                            <field name="opportunity_ids">

                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="customer_id"/>
                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <!-- Customer Search View -->
    <record id="view_customer_search" model="ir.ui.view">
        <field name="name">my.crm.customer.search</field>
        <field name="model">my.crm.customer</field>

        <field name="arch" type="xml">
            <search>

                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>

                <filter
                    name="has_email"
                    string="Has Email"
                    domain="[('email', '!=', False)]"
                />

                <filter
                    name="has_phone"
                    string="Has Phone"
                    domain="[('phone', '!=', False)]"
                />

                <filter
                    name="has_opportunity"
                    string="Has Opportunity"
                    domain="[('opportunity_ids', '!=', False)]"
                />

            </search>
        </field>
    </record>


    <!-- Customer Action -->
    <record id="action_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">my.crm.customer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_customer_search"/>
    </record>


    <!-- Main Menu -->
    <menuitem
        id="menu_my_crm_root"
        name="My CRM"
        sequence="10"/>


    <!-- Customer Menu -->
    <menuitem
        id="menu_customer"
        name="Customers"
        parent="menu_my_crm_root"
        action="action_customer"
        sequence="10"/>

</odoo>