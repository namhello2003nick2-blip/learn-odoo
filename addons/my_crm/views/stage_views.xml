<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_stage_list" model="ir.ui.view">
        <field name="name">my.crm.stage.list</field>
        <field name="model">my.crm.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="fold"/>
            </list>
        </field>
    </record>


    <record id="view_stage_form" model="ir.ui.view">
        <field name="name">my.crm.stage.form</field>
        <field name="model">my.crm.stage</field>

        <field name="arch" type="xml">
            <form>

                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="fold"/>
                    </group>

                    <notebook>

                        <page string="Opportunities">

                            <field name="opportunity_ids">

                                <list>
                                    <field name="name"/>
                                    <field name="customer_id"/>
                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>


    <record id="action_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">my.crm.stage</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem
        id="menu_stage"
        name="Stages"
        parent="menu_my_crm_root"
        action="action_stage"
        sequence="30"/>

</odoo>