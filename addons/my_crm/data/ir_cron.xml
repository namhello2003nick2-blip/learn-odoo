<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="ir_cron_auto_mark_expired_opportunities"
            model="ir.cron">

        <field name="name">
            Auto Mark Expired Opportunities
        </field>

        <field name="model_id"
               ref="model_my_crm_opportunity"/>

        <field name="state">code</field>

        <field name="code">
            model._cron_auto_mark_expired()
        </field>

        <field name="interval_number">1</field>

        <field name="interval_type">days</field>

        <field name="active">True</field>

    </record>

</odoo>